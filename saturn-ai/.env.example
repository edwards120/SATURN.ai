# SATURN.ai local configuration
# Copy this file to .env and add only the providers or integrations you use.
# Never commit the completed .env file.

# Preferred provider: ollama, openai, anthropic, gemini, or offline
SATURN_LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI — optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic — optional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini — optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional custom system prompt
SATURN_SYSTEM_PROMPT=

# Adobe — integration work in progress
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=

# Shopify — integration work in progress
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# SketchUp — local integration work in progress
SKETCHUP_PROJECTS_FOLDER=
SKETCHUP_EXE_PATH=

# Notion — integration work in progress
NOTION_TOKEN=
NOTION_DB_ID=

# Application
PORT=5000
NODE_ENV=development
